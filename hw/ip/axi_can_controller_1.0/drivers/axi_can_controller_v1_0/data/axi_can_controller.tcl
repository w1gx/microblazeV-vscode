###############################################################################
# Classic (XSCT/HSI) BSP generator for the AXI CAN Controller driver.
# Generated by vivado-axi-ip.
#
# Emits into xparameters.h:
#   XPAR_XAXICANCONTROLLER_NUM_INSTANCES
#   XPAR_<INSTANCE>_DEVICE_ID / _BASEADDR / _HIGHADDR / _<PARAM>
#   XPAR_XAXICANCONTROLLER_<n>_DEVICE_ID / _BASEADDR / _HIGHADDR      (canonical)
# and writes src/xaxi_can_controller_g.c with XAxiCanController_ConfigTable[].
# Base addresses come from the processor's memory map.
###############################################################################

proc generate {drv_handle} {
    set params {C_CLOCK_FREQUENCY C_BIT_RATE C_TQ_PER_BIT C_PHASE_SEG2 C_SJW C_RX_FIFO_DEPTH C_TX_BUFFERS C_FILTERS}
    set periphs [::hsi::utils::get_common_driver_ips $drv_handle]
    set sw_proc [hsi::get_sw_processor]
    set hw_proc [hsi::get_cells -hier [common::get_property HW_INSTANCE $sw_proc]]

    set mapped {}
    foreach p $periphs {
        set mr [hsi::get_mem_ranges -of_objects $hw_proc $p]
        if {[llength $mr] == 0} {
            puts "WARNING: axi_can_controller: [common::get_property NAME $p] is not mapped to $sw_proc, skipped"
            continue
        }
        lappend mapped [list $p [lindex $mr 0]]
    }

    set f [::hsi::utils::open_include_file "xparameters.h"]
    puts $f "/* Definitions for driver [string toupper axi_can_controller] */"
    puts $f "#define XPAR_XAXICANCONTROLLER_NUM_INSTANCES [llength $mapped]U"
    puts $f ""
    set i 0
    foreach entry $mapped {
        set p    [lindex $entry 0]
        set mr   [lindex $entry 1]
        set name [string toupper [common::get_property NAME $p]]
        puts $f "/* Definitions for peripheral $name */"
        puts $f "#define XPAR_${name}_DEVICE_ID $i"
        puts $f "#define XPAR_${name}_BASEADDR [common::get_property BASE_VALUE $mr]"
        puts $f "#define XPAR_${name}_HIGHADDR [common::get_property HIGH_VALUE $mr]"
        foreach prm $params {
            set v [common::get_property CONFIG.$prm $p]
            if {$v eq "true"} { set v 1 } elseif {$v eq "false"} { set v 0 }
            puts $f "#define XPAR_${name}_[string range $prm 2 end] $v"
        }
        puts $f ""
        puts $f "/* Canonical definitions for peripheral $name */"
        puts $f "#define XPAR_XAXICANCONTROLLER_${i}_DEVICE_ID XPAR_${name}_DEVICE_ID"
        puts $f "#define XPAR_XAXICANCONTROLLER_${i}_BASEADDR XPAR_${name}_BASEADDR"
        puts $f "#define XPAR_XAXICANCONTROLLER_${i}_HIGHADDR XPAR_${name}_HIGHADDR"
        puts $f ""
        incr i
    }
    close $f

    if {[llength $mapped] == 0} {
        return
    }
    set cf [open [file join "src" "xaxi_can_controller_g.c"] w]
    puts $cf "/* Generated by axi_can_controller.tcl - do not edit */"
    puts $cf "#include \"xparameters.h\""
    puts $cf "#include \"xaxi_can_controller.h\""
    puts $cf ""
    puts $cf "XAxiCanController_Config XAxiCanController_ConfigTable\[XPAR_XAXICANCONTROLLER_NUM_INSTANCES\] = \{"
    set n [llength $mapped]
    for {set i 0} {$i < $n} {incr i} {
        set sep [expr {$i < $n - 1 ? "," : ""}]
        puts $cf "\t\{ XPAR_XAXICANCONTROLLER_${i}_DEVICE_ID, XPAR_XAXICANCONTROLLER_${i}_BASEADDR \}$sep"
    }
    puts $cf "\};"
    close $cf
}
