# Author: w1gx
# Date:   2026-11-22
#
# Generate memory.ld and cpu.mk from the open block design.
#
#   gen_memmap <cpu_cell> <memory.ld> <cpu.mk>
#
# memory.ld  MEMORY { LMB ... DDR ... } for sw/link.ld
# cpu.mk     -march / -mabi for this CPU configuration (same rules as AMD's
#            system-device-tree cpu.tcl)
#
# Everything else (xparameters.h, driver config tables) comes from AMD's BSP
# generator, see scripts/build_bsp.sh.

proc gen_memmap {cpu ldfile mkfile} {
    set cpu_cell [get_bd_cells $cpu]

    # --- memory regions in the CPU's data address space ---------------------
    set regions {}
    foreach seg [get_bd_addr_segs -of_objects [get_bd_addr_spaces $cpu/Data]] {
        set slave [get_bd_addr_segs -of_objects $seg]
        if {[get_property USAGE $slave] ne "memory"} continue
        set cname [lindex [split $slave /] end-2]
        if {[string match *lmb_bram_if_cntlr* $cname]} { set rname LMB
        } elseif {[string match mig* $cname]}           { set rname DDR
        } else { set rname [string toupper [regsub -all {[^A-Za-z0-9]} $cname _]] }
        lappend regions [list $rname [format 0x%08X [get_property OFFSET $seg]] [get_property RANGE $seg]]
    }
    set lf [open $ldfile w]
    puts $lf "/* Generated by hw/gen_memmap.tcl from the block design. Do not edit. */"
    puts $lf "MEMORY\n\{"
    foreach r $regions {
        lassign $r name base range
        puts $lf [format "    %-4s (rwx) : ORIGIN = %s, LENGTH = 0x%08X" $name $base $range]
    }
    puts $lf "\}"
    close $lf

    # --- compiler flags ------------------------------------------------------
    foreach p {USE_MULDIV USE_ATOMIC USE_FPU USE_COMPRESSION USE_ICACHE USE_DCACHE
               USE_BITMAN_A USE_BITMAN_B USE_BITMAN_C USE_BITMAN_S} {
        set v [get_property CONFIG.C_$p $cpu_cell]
        set isa($p) [expr {$v eq "" ? 0 : $v}]
    }
    set march rv32i
    if {$isa(USE_MULDIV) > 0}      { append march m }
    if {$isa(USE_ATOMIC) > 0}      { append march a }
    if {$isa(USE_FPU) >= 1}        { append march f }
    if {$isa(USE_COMPRESSION) > 0} { append march c }
    append march _zicsr_zifencei
    if {$isa(USE_ICACHE) > 0 || $isa(USE_DCACHE) > 0} { append march _zicbom }
    foreach b {A B C S} { if {$isa(USE_BITMAN_$b) > 0} { append march _zb[string tolower $b] } }
    set mabi [expr {$isa(USE_FPU) >= 1 ? "ilp32f" : "ilp32"}]

    set mf [open $mkfile w]
    puts $mf "# Generated by hw/gen_memmap.tcl from the block design. Do not edit."
    puts $mf "MARCH := $march"
    puts $mf "MABI  := $mabi"
    close $mf
    puts "gen_memmap: wrote $ldfile, $mkfile (march=$march mabi=$mabi)"
}
